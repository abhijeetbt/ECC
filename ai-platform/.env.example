# ---- Anthropic (Claude) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Database (PostgreSQL) ----
# e.g. Railway / Fly.io / Neon / Supabase connection string
DATABASE_URL=postgresql://user:password@host:5432/ai_platform?schema=public

# ---- Clerk (auth) ----
# https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Route config (defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---- Stripe (subscriptions) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the Pro plan (used by the checkout flow you add in Phase 2)
STRIPE_PRO_PRICE_ID=price_...

# ---- Plan limits (monthly token allowance per tier) ----
FREE_TIER_TOKEN_LIMIT=100000
PRO_TIER_TOKEN_LIMIT=1000000
